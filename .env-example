# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env and fill in.  NEVER commit the real .env — it is git-ignored,
#  and scripts/pre-commit.hook blocks it.  After creating it:  chmod 600 .env
#
#  Two parsing gotchas, both of which have bitten this setup:
#
#   1. This file is read by Docker Compose's own parser, NOT by a shell.
#      Do not `source` it from a bash script — bash treats UID as READONLY and
#      the source aborts immediately under `set -e`.  Parse it explicitly, or
#      skip UID/EUID/PPID when importing.
#
#   2. Values are taken literally to end-of-line.  A value containing spaces
#      and commas (e.g.  FOO=a, b, c) is valid for Compose but is parsed by
#      bash as a command invocation.  Keep values space-free, or quote them.
#
#  Remove any variable you are not using rather than leaving it blank — stale
#  entries here have previously broken tooling that reads this file.
# ─────────────────────────────────────────────────────────────────────────────


# ── System ───────────────────────────────────────────────────────────────────
# Owner of the config directories. `id -u` / `id -g` — usually 1000 for the
# first user. Honoured only by linuxserver.io images (PUID/PGID); Home
# Assistant, Mosquitto, Zigbee2MQTT, Pi-hole, Nextcloud, Jellyseerr and Actual
# ignore them and write as root.
UID=1000
GID=1000

# tz database name, e.g. Europe/Zagreb, America/New_York
TZ=Region/City


# ── Paths ────────────────────────────────────────────────────────────────────
# Where the per-service config directories live. In the default layout this is
# this repository's own directory, so each service's config sits beside
# docker-compose.yml. A trailing slash is harmless.
DATA=/home/youruser/homeserver

# Media library root. Must contain the subdirectories the compose file mounts:
# Filmovi, Serije, Music, Crtici, Misc, MusicVideos, AudioBooks, Podcasts,
# Downloads. Typically a NAS mount.
MEDIA=/mnt/media


# ── Immich ───────────────────────────────────────────────────────────────────
# Pin a version for reproducible rebuilds. "release" tracks latest, which will
# break a restore if the backup predates a schema migration.
IMMICH_VERSION=release

# Where Immich writes uploaded photos and videos. This is primary data — make
# sure it is covered by your backups.
UPLOAD_LOCATION=/mnt/media/Pictures

# Optional read-only library Immich indexes in place without copying.
EXTERNAL_LIBRARY=/mnt/media/Pictures-external

# PostgreSQL data directory. A relative path is resolved against the compose
# file's directory, so `docker compose` must be run from the repository root.
# Never back this up by copying it while running — dump it instead:
#   docker exec -t immich_postgres pg_dumpall --clean --if-exists -U postgres
DB_DATA_LOCATION=./immich-postgres

# A-Za-z0-9 only — special characters break the connection string.
DB_PASSWORD=changeme

# These two are referenced by the Immich image itself. Leave as-is.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich


# ── Nextcloud ────────────────────────────────────────────────────────────────
# Admin account, created on first start only. Changing it later has no effect;
# use the web UI or `occ`.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=changeme

# MariaDB credentials. All three are read on first start of the db container;
# changing them afterwards requires migrating the database.
NEXTCLOUD_MYSQL_USER=nextcloud
NEXTCLOUD_MYSQL_PASSWORD=changeme
NEXTCLOUD_MYSQL_ROOT_PASSWORD=changeme


# ── SWAG: reverse proxy, TLS ─────────────────────────────────────────────────
# Base domain. Certificates are issued for this plus everything below.
URL=yourdomain.duckdns.org

# Comma-separated, NO spaces. Each becomes <name>.${URL} on the certificate.
# Every entry needs a matching *.subdomain.conf in swag/nginx/proxy-confs/,
# otherwise the certificate covers a hostname that serves nothing.
SUBDOMAINS=jellyfin,music,photos,cloud,home

# Fully-qualified names outside ${URL}. Usually only needed for a second domain.
EXTRA_DOMAINS=

# Contact address for Let's Encrypt expiry notices.
EMAIL=you@example.com

# How Let's Encrypt proves you own the domain:
#   http    — requires inbound port 80 to reach this host. No token needed,
#             but cannot issue wildcard certificates.
#   duckdns — DNS-01 via the DuckDNS API. Needs DUCKDNS_TOKEN below, does not
#             need port 80, and can issue wildcards.
VALIDATION=http

# Required only when VALIDATION=duckdns. Found at https://www.duckdns.org
# after signing in.
#DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000


# ── Pi-hole ──────────────────────────────────────────────────────────────────
# NOTE: Pi-hole v6 replaced WEBPASSWORD with FTLCONF_webserver_api_password,
# and dropped SERVERIP / FTLCONF_LOCAL_IPV4 entirely. If you are on v6, this
# variable is ignored on anything but a fresh install — set the password in the
# web UI instead, and check `pihole/etc-pihole/versions` for your version.
PIHOLE_WEBPASSWORD=changeme

# LAN address of this host. Legacy v5 variable, kept for older deployments.
PIHOLE_HOST_SERVERIP=192.168.1.10


# ── Navidrome: Last.fm scrobbling ────────────────────────────────────────────
# Optional. Create an API account at https://www.last.fm/api/account/create
# Omit both lines to disable scrobbling.
ND_LASTFM_APIKEY=00000000000000000000000000000000
ND_LASTFM_SECRET=00000000000000000000000000000000


# ── Backup ───────────────────────────────────────────────────────────────────
# Destination for backups.
#
# MUST NOT be on the same filesystem as MEDIA or DATA. A "backup" written to
# the volume it is protecting survives a deleted file and nothing else — not a
# failed array, not ransomware, not a mistaken rm -rf.
#
# Verify before trusting it:  df --output=source /path/to/media /path/to/backup
# If both lines report the same device, this is not a backup.
NAS_BACKUP_MOUNT=/mnt/backup
