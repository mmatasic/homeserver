# Example for /root/.b2-credentials — sourced by scripts/restic-backup.sh in
# offsite mode. Copy to the server as root, 0600. It lives in /root, NOT in
# this repository: the repo is public and the application key is a secret.
#
#   sudo install -m 600 /dev/null /root/.b2-credentials
#   sudo nano /root/.b2-credentials
#
# NOT captured by any backup, and unlike the other root-only files this one is
# needed to READ the offsite copy. Store the key in your password manager next
# to the restic passphrase — without it the offsite repo is unreachable in
# exactly the situation it exists for. See DISASTER_RECOVERY.md step 0.1.

# From Account -> Application Keys -> Add a New Application Key.
# Scope it to the single bucket with read+write; do not use the master key.
B2_ACCOUNT_ID=""        # the keyID
B2_ACCOUNT_KEY=""       # the applicationKey, shown only once

# b2:<bucket>:<path-inside-bucket>
OFFSITE_REPO="b2:YOUR-BUCKET-NAME:homeserver"
